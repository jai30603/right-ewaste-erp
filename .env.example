# Set APP_ENV to production when deploying outside a local development machine.
APP_ENV=production
SESSION_SECRET=replace-with-a-long-random-secret

# Password values must be Werkzeug password hashes, not plaintext values.
# Generate one with:
# python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('choose-a-strong-password'))"
ERP_ADMIN_USERNAME=admin
ERP_ADMIN_PASSWORD_HASH=replace-with-a-werkzeug-password-hash

# Optional operational account. Operators can create and edit records; only
# administrators can delete records.
ERP_OPERATOR_USERNAME=operator
ERP_OPERATOR_PASSWORD_HASH=replace-with-a-werkzeug-password-hash

# Optional read-only account.
ERP_VIEWER_USERNAME=viewer
ERP_VIEWER_PASSWORD_HASH=replace-with-a-werkzeug-password-hash
